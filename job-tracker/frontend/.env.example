# Leave both unset in development — vite.config.ts proxies /api and /ws to
# localhost:8000, which keeps the browser on a single origin.
#
# Set these when the frontend is served from a different host than the API
# (any real deployment). The backend must also list that origin in the
# CORSMiddleware allow_origins in app/main.py.
VITE_API_URL=
VITE_WS_URL=
