# Copy to .env and fill in. Used when running uvicorn directly;
# docker-compose passes these as real environment variables instead
# (and .dockerignore keeps .env out of the image entirely).

# Required.
DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5432/jobtracker
REDIS_URL=redis://localhost:6379/0

# Required. Signs your JWTs — any long random string.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_Secret_Key=

# Optional. Publishing fails open, so a missing broker degrades to
# "no reminder emails" rather than breaking status changes.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Optional. False prints the email to the console instead of sending it,
# which makes the whole RabbitMQ pipeline testable without SMTP credentials.
EMAILS_ENABLED=False
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Required for the /ai endpoints. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Comma-separated browser origins allowed to call this API. Must include the
# deployed frontend's origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
