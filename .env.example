# Copy to .env, then fill in. Read by docker-compose.yml only —
# backend/.env is the separate file used when running uvicorn directly.
#
#     cp .env.example .env

# Required. Any long random string; this signs your JWTs.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Required for the /ai endpoints. Without it the AI pages render but every
# request fails. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres. Defaults are fine for local use — override for anything exposed.
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=jobtracker
POSTGRES_DB=jobtracker

# Email. False makes the worker print the email to the console instead of
# sending it, so the RabbitMQ pipeline is testable without SMTP credentials.
EMAILS_ENABLED=False
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
